{
  "redirects": [
    { "source": "/services", "destination": "/", "permanent": true },
    { "source": "/services/", "destination": "/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/go/:id", "destination": "/api/go/:id" },
    { "source": "/claim/:token", "destination": "/api/claim/:token" },
    { "source": "/audit-report/:slug/:token", "destination": "/share/audit/index.html" },
    { "source": "/audit-report/:token", "destination": "/share/audit/index.html" }
  ],
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(logo.png|logo.svg|logo-64.webp|logo-128.webp|logo-512.png|apple-touch-icon.png|og-image.png|favicon.ico|favicon-16x16.png|favicon-32x32.png|favicon-48x48.png|android-chrome-192x192.png|android-chrome-512x512.png|site.webmanifest)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }
      ]
    }
  ],
  "functions": {
    "api/estimate.js": {
      "maxDuration": 300,
      "memory": 1024
    },
    "api/analyze.js": {
      "maxDuration": 30,
      "memory": 1024
    },
    "api/estimates.js": {
      "maxDuration": 300,
      "memory": 1024
    },
    "api/generate-preview.js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/segment.js": {
      "maxDuration": 30,
      "memory": 1024
    },
    "api/audit/request.js": {
      "maxDuration": 200,
      "memory": 3009,
      "includeFiles": "node_modules/{lighthouse,axe-core,http-link-header}/**"
    },
    "api/admin/recrawl.js": {
      "maxDuration": 200,
      "memory": 3009,
      "includeFiles": "node_modules/{lighthouse,axe-core,http-link-header}/**"
    },
    "api/admin/carousel/fill.js": {
      "maxDuration": 200
    },
    "api/admin/carousel/generate-images.js": {
      "maxDuration": 200
    },
    "api/admin/carousel/regenerate-slide-image.js": {
      "maxDuration": 60
    },
    "api/admin/carousel/publish.js": {
      "maxDuration": 300
    },
    "api/cron/carousel-nightly.js": {
      "maxDuration": 200
    },
    "api/webhooks/voice/inbound.js": {
      "maxDuration": 30
    },
    "api/webhooks/voice/recording.js": {
      "maxDuration": 30
    },
    "api/webhooks/sms/inbound.js": {
      "maxDuration": 30
    },
    "api/webhooks/web/capture.js": {
      "maxDuration": 30
    },
    "api/places-photo.js": {
      "maxDuration": 20
    }
  },
  "crons": [
    { "path": "/api/cron/carousel-nightly", "schedule": "0 9 * * *" }
  ]
}
