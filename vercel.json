{
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(logo.png|apple-touch-icon.png|og-image.png)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "functions": {
    "api/estimate.js": {
      "maxDuration": 300,
      "memory": 1024
    },
    "api/analyze.js": {
      "maxDuration": 30,
      "memory": 1024
    },
    "api/estimates.js": {
      "maxDuration": 300,
      "memory": 1024
    },
    "api/generate-preview.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  }
}
